# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# These are not secrets, but they are kept out of the repo. Leave them empty to run on this device only.
VITE_FIREBASE_API_KEY=
# Use <projectId>.firebaseapp.com: Google's sign-in settings accept it out of the box.
# (<projectId>.web.app only works after adding https://<projectId>.web.app/__/auth/handler as a
# redirect URI on the OAuth client in Google Cloud console > APIs & Services > Credentials.)
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
