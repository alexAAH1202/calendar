# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# These are not secrets, but they are kept out of the repo. Leave them empty to run on this device only.
VITE_FIREBASE_API_KEY=
# Use your Hosting domain, e.g. my-family-calendar.web.app, so Google sign-in stays on the same site.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
